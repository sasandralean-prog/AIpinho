AIPINHO_ENV=local
AIPINHO_HOST=0.0.0.0
AIPINHO_PORT=9088
AIPINHO_AUX_PORT=9089

# OpenAI is optional and disabled by default in this installation.
# Lucio OpenAI-backed chat is kept only as disabled/read-only compatibility.
OPENAI_ENABLED=false
LUCIO_ENABLED=false
LUCIO_PROVIDER=disabled
DEFAULT_TEXT_AGENT=gemini
# Optional only if a future Lucio/OpenAI profile is explicitly re-enabled.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_PROJECT=
OPENAI_ORGANIZATION=
LUCIO_AGENT_ENABLED=false
LUCIO_AGENT_DEFAULT_MODEL=gpt-5.5
LUCIO_AGENT_TIMEOUT_SECONDS=120
LUCIO_AGENT_MAX_PROMPT_CHARS=200000
LUCIO_AGENT_MAX_OUTPUT_CHARS=65536
LUCIO_AGENT_USE_MEMORY_GATEWAY=true
LUCIO_AGENT_USE_DELEGATION=true
LUCIO_AGENT_DEFAULT_EXECUTION_MODE=governed_autorun
LUCIO_AGENT_ALLOW_DIRECT_LOCAL_TOOLS=false

# Gemini Executor uses backend-only secrets. Never put real keys in Android,
# Launcher UI, logs, reports, raw/debug, or committed files.
GEMINI_API_KEY_PRIMARY=
GEMINI_API_KEY_SECONDARY=
GEMINI_API_KEY_FALLBACK_1=
GEMINI_API_KEY_FALLBACK_2=
# Optional comma-separated backend-only fallback sequence.
GEMINI_API_KEYS=
GEMINI_EXECUTOR_ENABLED=true
GEMINI_EXECUTOR_DEFAULT_MODEL=gemini-2.5-flash
GEMINI_EXECUTOR_TIMEOUT_SECONDS=90
GEMINI_EXECUTOR_MAX_PROMPT_CHARS=200000
GEMINI_EXECUTOR_MAX_OUTPUT_CHARS=65536
GEMINI_EXECUTOR_ALLOW_WRITE=true
GEMINI_EXECUTOR_ALLOW_SHELL=true
GEMINI_EXECUTOR_REQUIRE_APPROVAL_FOR_WRITE=true
GEMINI_EXECUTOR_REQUIRE_APPROVAL_FOR_SHELL=true
GEMINI_AGENT_DEFAULT_EXECUTION_MODE=governed_autorun
GEMINI_AGENT_USE_MEMORY_GATEWAY=true
GEMINI_AGENT_USE_DELEGATION=true
GEMINI_AGENT_PREFER_AIPINHO_EXECUTOR=true
GEMINI_AGENT_ALLOW_DIRECT_LOCAL_TOOLS=false
GEMINI_AGENT_AUTORUN_ENABLED=true
GEMINI_AGENT_AUTOREVIEW_ENABLED=true
GEMINI_AGENT_AUTOAPPROVAL_ENABLED=true
GEMINI_AGENT_RAW_DEFAULT_VISIBLE=false
GEMINI_AGENT_CLOUD_WARNING_VISIBLE=true

# Codex Agent uses an already-authenticated local Codex CLI. Do not store
# OpenAI/Codex session tokens, browser cookies, passwords, or private desktop
# app credentials here.
CODEX_AGENT_ENABLED=true
CODEX_AGENT_CLI_PATH=C:\Dev\Dependencias\codex-cli\node_modules\@openai\codex-win32-x64\vendor\x86_64-pc-windows-msvc\bin\codex.exe
CODEX_AGENT_DEFAULT_WORKDIR=C:\Dev\AIpinho
CODEX_AGENT_TIMEOUT_SECONDS=600
CODEX_AGENT_REQUIRE_APPROVAL_FOR_WRITE=true
CODEX_AGENT_REQUIRE_APPROVAL_FOR_SHELL=true
CODEX_AGENT_ALLOW_READ=true
CODEX_AGENT_ALLOW_WRITE=true
CODEX_AGENT_ALLOW_SHELL=true
CODEX_AGENT_USE_STAGING_WORKTREE=true
CODEX_AGENT_MAX_OUTPUT_CHARS=200000
CODEX_AGENT_HISTORY_RETENTION_DAYS=90
CODEX_AGENT_HISTORY_CONTEXT_MESSAGES=20
CODEX_AGENT_HISTORY_CONTEXT_CHARS=24000
CODEX_AGENT_MOBILE_ENABLED=true
CODEX_AGENT_AUTORUN_ENABLED=true
CODEX_AGENT_AUTOREVIEW_ENABLED=true
CODEX_AGENT_AUTO_APPROVAL_ENABLED=true
CODEX_AGENT_AUTOPILOT_MODE=governed_autorun
CODEX_AGENT_POLLING_INTERVAL_SECONDS=5
CODEX_AGENT_MAX_RUN_SECONDS=1800
CODEX_AGENT_MAX_SHELL_SECONDS=600
CODEX_AGENT_MAX_EVENTS_PER_POLL=100
CODEX_AGENT_MAX_OUTPUT_CHARS_PER_EVENT=12000
CODEX_AGENT_ALLOW_ARTIFACT_UPLOAD=true
CODEX_AGENT_ALLOW_ARTIFACT_DOWNLOAD=true
CODEX_AGENT_AUTO_APPROVE_READ=true
CODEX_AGENT_AUTO_APPROVE_ARTIFACT_UPLOAD=true
CODEX_AGENT_AUTO_APPROVE_ARTIFACT_DOWNLOAD=true
CODEX_AGENT_AUTO_APPROVE_WRITE_IN_TARGET_MUTABLE=true
CODEX_AGENT_AUTO_APPROVE_READONLY_SHELL=true
CODEX_AGENT_AUTO_APPROVE_TEST_SHELL=true
CODEX_AGENT_AUTO_APPROVE_BUILD_SHELL=true
CODEX_AGENT_AUTO_APPROVE_DESTRUCTIVE_SHELL=false
CODEX_AGENT_AUTO_APPROVE_GIT_WRITE=false
CODEX_AGENT_AUTO_APPROVE_NETWORK_SHELL=false
CODEX_AGENT_AUTO_APPROVE_PROCESS_CONTROL=false
CODEX_AGENT_AUTO_APPROVE_FORBIDDEN_WORKSPACE=false
CODEX_AGENT_REQUIRE_HUMAN_FOR_HIGH_RISK=true
CODEX_AGENT_EMERGENCY_STOP_ENABLED=true
CODEX_AGENT_AUTORUN_MAX_STEPS=20
CODEX_AGENT_AUTORUN_MAX_FILE_WRITES=50
CODEX_AGENT_AUTORUN_MAX_SHELL_COMMANDS=20
CODEX_AGENT_AUTORUN_MAX_ARTIFACTS=20
